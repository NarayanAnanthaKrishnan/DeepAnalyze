# ── Swaylytics configuration ──────────────────────────────────────────
# Copy to .env and fill in values. Never commit the real .env.

# Required: Google Gemini (powers planning, router, reports)
GEMINI_API_KEY =
GEMINI_MODEL = gemini-3-flash-preview

# ── Trial gate (public deployments) ───────────────────────────────────
# Supabase project (Auth OTP + trials table). Leave empty for local dev,
# which disables gating entirely.
SUPABASE_URL =
NEXT_PUBLIC_SUPABASE_URL =            # same value, read by the frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY =       # Supabase Settings -> API -> anon
SUPABASE_SERVICE_KEY =                # Supabase Settings -> API -> service_role (server-only!)
SUPABASE_JWT_SECRET =                 # only needed for legacy HS256 Supabase projects
GATE_ENFORCED = true                  # false disables the gate entirely (dev)

# Owner escape hatch: header "X-Admin-Key: <value>" bypasses the gate
ADMIN_KEY =                           # invent a long random string
ADMIN_EMAILS =                        # optional comma-separated allowlist, e.g. you@gmail.com

# ── Agent loop safety ─────────────────────────────────────────────────
DEMO_MAX_ROUNDS = 8                   # graceful wrap-up after N agent rounds

# ── Backend ───────────────────────────────────────────────────────────
DEEPANALYZE_BACKEND_HOST = 0.0.0.0
DEEPANALYZE_BACKEND_PORT = 8200
DEEPANALYZE_EXECUTION_TIMEOUT_SEC = 120
DEEPANALYZE_WORKSPACE_BASE = workspace
TRIAL_DB_PATH = data/trials.db        # SQLite fallback when Supabase isn't configured
ENABLE_PROXY = false                  # keep off publicly (open SSRF relay)

# Comma-separated browser origins allowed to call the API ("*" for dev)
ALLOWED_ORIGINS = http://localhost:3000

# Legacy DeepAnalyze-8B engine (optional)
DEEPANALYZE_API_BASE = http://localhost:8000/v1
DEEPANALYZE_MODEL_PATH = DeepAnalyze-8B
